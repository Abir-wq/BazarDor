# 1) Required: use a random secret of at least 32 characters.
# Generate it with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# 2) Optional locally. Without DATABASE_URL the app uses local SQLite.
# Production hosts like Vercel require a persistent PostgreSQL DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_SSL=true

# 3) Needed to make social sign-in buttons actually work.
# Add the same variables on your deployed hosting account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
